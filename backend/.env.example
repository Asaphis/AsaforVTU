# PostgreSQL Database Configuration (Neon)
# Get your connection string from Neon Console
DATABASE_URL=postgresql://username:password@ep-cool-region-123456.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# Add your frontend URLs here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://asaforvtu.onrender.com,https://www.asafor.com,https://vtu.ferixas.com,https://vtuportal.ferixas.com,https://vtuapi.ferixas.com

# Admin Emails (comma-separated)
ADMIN_EMAILS=admin@example.com,osglimited7@gmail.com

# VTU Provider Configuration (IACafe)
VTU_PROVIDER_URL=https://iacafe.com.ng/devapi/v1
VTU_PROVIDER_API_KEY=your_provider_api_key

# Flutterwave Payment Configuration
# Get these from Flutterwave Dashboard > Settings > API Keys
# Use TEST keys for testing, LIVE keys for production
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-dab7ec14b64b916ad4716dc5cb34ebfd-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-c5d29f25da5ed4286d31197f4043b276-X

# For LIVE mode, use:
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE-xxxxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE-xxxxx

# Flutterwave Webhook Secret Hash
# Get from Flutterwave Dashboard > Settings > Webhooks > Live
# Click "Reveal" next to Secret Hash
FLW_SECRET_HASH=whsec_a1b2c3d4e5f6

# Payment Redirect URL (after payment completion)
FLW_REDIRECT_URL=https://asaforvtu.onrender.com/payment-complete

# Optional: Cron Job Configuration
CRON_ENABLED=true
